---
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';

interface Props {
  annotation?: boolean;
  label?: boolean;
  taint?: boolean;
  resourceClaim?: boolean;
  oci?: boolean;
  contexts?: string[];
}

const {
  annotation = false,
  label = false,
  taint = false,
  resourceClaim = false,
  oci = false,
  contexts = [],
} = Astro.props;

// Map simple prop names to context IDs
const contextIdMap: Record<string, string> = {
  'annotation': 'kubernetesAnnotation',
  'label': 'kubernetesLabel',
  'taint': 'kubernetesTaint',
  'resourceClaim': 'kubernetesResourceClaim',
  'oci': 'ociAnnotation',
};

// Read context files directly from filesystem
const contextsDir = path.join(process.cwd(), 'src/data/contexts');
const contextFiles = fs.readdirSync(contextsDir).filter(f => f.endsWith('.mdx') && !f.startsWith('_'));

interface Context {
  id: string;
  title: string;
  short: string;
  moreInformation: string;
}

const contextUses: Context[] = [];

for (const filename of contextFiles) {
  const filepath = path.join(contextsDir, filename);
  const content = fs.readFileSync(filepath, 'utf-8');
  const frontmatterMatch = content.match(/^---\n([\s\S]*?)\n---/);
  if (frontmatterMatch) {
    const frontmatter = yaml.load(frontmatterMatch[1]) as {
      id?: string;
      title?: string;
      short?: string;
      moreInformation?: string;
    };
    if (frontmatter.id && frontmatter.title) {
      contextUses.push({
        id: frontmatter.id,
        title: frontmatter.title,
        short: frontmatter.short || frontmatter.title,
        moreInformation: frontmatter.moreInformation || '#',
      });
    }
  }
}

// Canonical fixed order for consistent comparison across all key pages
const CANONICAL_CONTEXT_ORDER = [
  'kubernetesAnnotation',
  'kubernetesLabel',
  'kubernetesTaint',
  'kubernetesResourceClaim',
  'ociAnnotation',
];

// Sort contextUses according to canonical order
contextUses.sort((a, b) => {
  const indexA = CANONICAL_CONTEXT_ORDER.indexOf(a.id);
  const indexB = CANONICAL_CONTEXT_ORDER.indexOf(b.id);
  const posA = indexA !== -1 ? indexA : 999;
  const posB = indexB !== -1 ? indexB : 999;
  if (posA !== posB) return posA - posB;
  return a.title.localeCompare(b.title);
});

// If contexts array is provided, use it directly
// Otherwise, build from boolean props
let enabledContextIds: string[];
if (contexts.length > 0) {
  enabledContextIds = contexts.map(c => contextIdMap[c] || c);
} else {
  enabledContextIds = [];
  if (annotation) enabledContextIds.push('kubernetesAnnotation');
  if (label) enabledContextIds.push('kubernetesLabel');
  if (taint) enabledContextIds.push('kubernetesTaint');
  if (resourceClaim) enabledContextIds.push('kubernetesResourceClaim');
  if (oci) enabledContextIds.push('ociAnnotation');
}
---

<div class="not-content" style="margin: 0.75rem 0 1.5rem 0;">
  <div class="context-badges-grid">
    {contextUses.map(context => {
      const isEnabled = enabledContextIds.includes(context.id);
      return isEnabled ? (
        <a 
          href={context.moreInformation}
          class="context-badge enabled"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>{context.short}</span>
          <span class="badge-status">✓</span>
        </a>
      ) : (
        <div class="context-badge disabled">
          <span>{context.short}</span>
          <span class="badge-status">—</span>
        </div>
      );
    })}
  </div>
</div>
