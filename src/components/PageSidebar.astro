---
import TableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';

const { starlightRoute } = Astro.locals;
const entryId = starlightRoute.id || starlightRoute.entry?.id || '';

// URLs for right-sidebar action links
const editThisPageUrl = starlightRoute.editUrl || `https://github.com/controlplaneio/native-cloud/edit/main/src/content/docs/${entryId}`;
const editKeysUrl = 'https://github.com/controlplaneio/native-cloud/tree/main/src/content/docs/groups';
const createNewKeyUrl = 'https://github.com/controlplaneio/native-cloud/issues/new?title=%5BNew+Key+Proposal%5D&labels=new-key';
const createIssueUrl = `https://github.com/controlplaneio/native-cloud/issues/new?title=%5BFeedback%5D+${encodeURIComponent(starlightRoute.entry?.data?.title || 'Documentation')}&labels=feedback`;
---

{
	starlightRoute.toc && (
		<>
			<div class="lg:sl-hidden">
				<MobileTableOfContents {...Astro.props} />
			</div>
			<div class="right-sidebar-panel sl-hidden lg:sl-block">
				<div class="sl-container">
					<TableOfContents {...Astro.props} />

					<div class="right-sidebar-actions">
						<h2 class="sidebar-actions-title">Actions</h2>
						<ul class="sidebar-actions-list">
							<li>
								<a href={editThisPageUrl} target="_blank" rel="noopener noreferrer" class="sidebar-action-link">
									<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
										<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
									</svg>
									<span>Edit this page</span>
								</a>
							</li>
							<li>
								<a href={editKeysUrl} target="_blank" rel="noopener noreferrer" class="sidebar-action-link">
									<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
										<polyline points="9 22 9 12 15 12 15 22"></polyline>
									</svg>
									<span>Edit keys</span>
								</a>
							</li>
							<li>
								<a href={createNewKeyUrl} target="_blank" rel="noopener noreferrer" class="sidebar-action-link">
									<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<line x1="12" y1="5" x2="12" y2="19"></line>
										<line x1="5" y1="12" x2="19" y2="12"></line>
									</svg>
									<span>Create new key</span>
								</a>
							</li>
							<li>
								<a href={createIssueUrl} target="_blank" rel="noopener noreferrer" class="sidebar-action-link">
									<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="10"></circle>
										<line x1="12" y1="8" x2="12" y2="12"></line>
										<line x1="12" y1="16" x2="12.01" y2="16"></line>
									</svg>
									<span>Create an issue</span>
								</a>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</>
	)
}

<style>
	@layer starlight.core {
		.right-sidebar-panel {
			padding: 1rem var(--sl-sidebar-pad-x);
		}
		.sl-container {
			width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
		}
		@media (min-width: 72rem) {
			.sl-container {
				max-width: calc(
					(
						(
								100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 *
									var(--sl-sidebar-pad-x)
							) * 0.25
					)
				);
			}
		}
	}
</style>
