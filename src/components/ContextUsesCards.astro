---
interface ContextModule {
  frontmatter: {
    id: string;
    title: string;
    moreInformation?: string;
  };
  Content: any;
}

const contextModules = import.meta.glob<ContextModule>('../data/contexts/*.mdx', { eager: true });

const contextUses = Object.values(contextModules)
  .map(mod => ({
    id: mod.frontmatter.id,
    title: mod.frontmatter.title,
    moreInformation: mod.frontmatter.moreInformation || '#',
    Content: mod.Content,
  }))
  .filter(c => c.id && c.title)
  .sort((a, b) => a.title.localeCompare(b.title));
---

<div class="context-uses-cards">
  <div class="context-uses-grid">
    {contextUses.map(({ title, moreInformation, Content }) => (
      <div class="context-use-card">
        <h3 class="context-use-title">{title}</h3>
        <div class="context-use-description">
          <Content />
        </div>
        <a href={moreInformation} class="context-use-link" target="_blank" rel="noopener noreferrer">
          Learn more
        </a>
      </div>
    ))}
  </div>
</div>

<style>
  .context-uses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  .context-use-card {
    border: 2px solid var(--sl-color-accent);
    border-radius: 8px;
    padding: 1.25rem;
    transition: outline 0.2s ease, transform 0.2s ease;
  }

  .context-use-card:has(.context-use-link:hover)  {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .context-use-title {
    margin: 0 0 1rem 0;
    color: var(--sl-color-text);
  }

  .context-use-description {
    margin: 0 0 1.25rem 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .context-use-description p {
    margin: 0;
  }

  .context-use-link {
    display: inline-block;
    color: var(--sl-color-accent);
    text-decoration: none;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    transition: background-color 0.2s ease;
  }

  .context-use-link:hover {
    background-color: var(--sl-color-accent);
    color: var(--sl-color-bg);
  }
</style>
