---
---
<theme-toggle>
  <button aria-label="Toggle light and dark theme" id="theme-toggle" class="theme-toggle-btn" title="Toggle light & dark theme">
    <svg aria-hidden="true" height="20" viewBox="0 0 24 24" width="20">
      <mask class="moon" id="moon-mask">
        <rect x="0" y="0" width="100%" height="100%" fill="white"></rect>
        <circle cx="24" cy="10" r="6" fill="black"></circle>
      </mask>
      <circle class="sun" cx="12" cy="12" r="6" mask="url(#moon-mask)" fill="currentColor"></circle>
      <g class="sun-beams" stroke="currentColor">
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </g>
    </svg>
  </button>

  <script>
    class ThemeSwitcher extends HTMLElement {
      private mediaQuery = window.matchMedia('(prefers-color-scheme: light)');

      constructor() {
        super();
        const storedTheme = typeof localStorage !== 'undefined' ? localStorage.getItem('starlight-theme') : null;
        const systemTheme = this.mediaQuery.matches ? 'light' : 'dark';
        const activeTheme = (storedTheme === 'light' || storedTheme === 'dark') ? storedTheme : systemTheme;
        
        document.documentElement.dataset.theme = activeTheme;
        this.handleClick = this.handleClick.bind(this);
        this.handleMediaChange = this.handleMediaChange.bind(this);
        this.updateMaskPosition(activeTheme);
      }

      connectedCallback() {
        const btn = this.querySelector('#theme-toggle');
        if (btn) {
          btn.addEventListener('click', this.handleClick);
        }
        this.mediaQuery.addEventListener('change', this.handleMediaChange);
        
        // Sync on connect
        const current = document.documentElement.dataset.theme || (this.mediaQuery.matches ? 'light' : 'dark');
        this.updateMaskPosition(current);
      }

      disconnectedCallback() {
        const btn = this.querySelector('#theme-toggle');
        if (btn) {
          btn.removeEventListener('click', this.handleClick);
        }
        this.mediaQuery.removeEventListener('change', this.handleMediaChange);
      }

      private handleMediaChange(e: MediaQueryListEvent) {
        const stored = localStorage.getItem('starlight-theme');
        if (!stored || stored === 'auto') {
          const newTheme = e.matches ? 'light' : 'dark';
          document.documentElement.dataset.theme = newTheme;
          this.updateMaskPosition(newTheme);
        }
      }

      private updateMaskPosition(theme: string) {
        const maskCircle = this.querySelector('#moon-mask circle:last-child');
        if (maskCircle) {
          maskCircle.setAttribute('cx', theme === 'dark' ? '17' : '24');
        }
      }

      private handleClick() {
        const currentTheme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
        const nextTheme = currentTheme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = nextTheme;
        localStorage.setItem('starlight-theme', nextTheme);
        this.updateMaskPosition(nextTheme);
      }
    }

    if (!customElements.get('theme-toggle')) {
      customElements.define('theme-toggle', ThemeSwitcher);
    }
  </script>

  <style>
    theme-toggle {
      --animation-duration: 400ms;
      display: grid;
      grid-area: theme-toggle;
      place-items: center;
    }

    .theme-toggle-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 1px solid var(--nc-card-border, #2d333f);
      border-radius: 0.375rem;
      padding: 0.35rem 0.5rem;
      cursor: pointer;
      color: var(--sl-color-gray-2);
      transition: all 0.2s ease;
    }

    .theme-toggle-btn:hover {
      color: var(--sl-color-accent);
      border-color: var(--sl-color-accent);
      background: var(--nc-card-bg, #1a1d24);
    }

    svg {
      stroke-linecap: round;

      & > :is(.moon, .sun, .sun-beams) {
        transform-origin: center;
      }

      & > :is(.moon, .sun) {
        fill: currentColor;
      }

      & > .sun-beams {
        stroke: currentColor;
        stroke-width: 2px;
      }

      :is(html[data-theme='dark']) & {
        & > .sun {
          transform: scale(1.75);
        }

        & > .sun-beams {
          opacity: 0;
        }

        & > .moon > circle {
          transform: translateX(-7px);

          @supports (cx: 1) {
            cx: 17;
            transform: translateX(0);
          }
        }
      }

      @media (prefers-reduced-motion: no-preference) {
        & > .sun {
          transition: transform var(--animation-duration) cubic-bezier(0.4, 0, 0.2, 1);
        }

        & > .sun-beams {
          transition:
            transform var(--animation-duration) cubic-bezier(0.4, 0, 0.2, 1),
            opacity var(--animation-duration) ease;
        }

        & .moon > circle {
          transition: transform calc(var(--animation-duration) / 2) ease-out;

          @supports (cx: 1) {
            transition: cx calc(var(--animation-duration) / 2) ease-out;
          }
        }

        :is(html[data-theme='dark']) & {
          & > .sun {
            transform: scale(1.75);
            transition-duration: calc(var(--animation-duration) / 2);
            transition-timing-function: ease;
          }

          & > .sun-beams {
            transform: rotateZ(-25deg);
            transition-duration: calc(var(--animation-duration) / 4);
          }

          & > .moon > circle {
            transition-delay: calc(var(--animation-duration) / 4);
            transition-duration: var(--animation-duration);
          }
        }
      }
    }
  </style>
</theme-toggle>
