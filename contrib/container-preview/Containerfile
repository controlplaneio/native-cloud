FROM node:22-bookworm-slim

ENV ASTRO_TELEMETRY_DISABLED=1 \
    HOME=/tmp \
    npm_config_cache=/tmp/.npm

# Dependencies go into /app/node_modules in the image. At runtime the
# checkout is mounted read-only over /app, with a named volume (initialised from
# this image) layered on top at /app/node_modules.
WORKDIR /app
RUN chown node:node /app
USER node
COPY --chown=node:node package.json package-lock.json ./
RUN mkdir dist .astro && npm ci --no-audit --no-fund
